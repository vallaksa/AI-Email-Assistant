# Email-Assistant Environment Variables Template
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and fill in your actual values
# 3. .env is in .gitignore and NEVER committed to git
# 4. Load environment: source .env
# 5. Run app: mvn spring-boot:run

# ============================================================================
# GMAIL OAUTH2 CONFIGURATION (REQUIRED)
# ============================================================================
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com
# 2. Create OAuth2 credentials
# 3. Download credentials JSON
# 4. Copy client_id and client_secret below

GMAIL_EMAIL=your-email@gmail.com
GMAIL_CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth2-client-secret

# ============================================================================
# AI MODEL CONFIGURATION (REQUIRED)
# ============================================================================
# Ollama Model Configuration
AI_MODEL_NAME=mistral
AI_MODEL_API_URL=http://localhost:11434/api/generate
AI_MODEL_API_KEY=

# ============================================================================
# OPTIONAL TIMEOUTS (Leave as is unless you have issues)
# ============================================================================
AI_MODEL_CONNECT_TIMEOUT=10000
AI_MODEL_READ_TIMEOUT=60000

# ============================================================================
# OPTIONAL LOGGING LEVELS
# ============================================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_AI_EMAILASSISTANT=DEBUG

