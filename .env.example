# Email Assistant (Python + Streamlit) Environment Variables
# 1) Copy: cp .env.example .env
# 2) Fill in values

# ---------------------------------------------------------------------------
# GMAIL OAUTH2 CONFIGURATION
# ---------------------------------------------------------------------------
GMAIL_EMAIL=your-email@gmail.com
GMAIL_CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth2-client-secret

# Optional: override defaults
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKENS_DIR=tokens
GMAIL_OAUTH_PORT=8888

# ---------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION
# ---------------------------------------------------------------------------
AI_API_URL=http://localhost:11434/api/generate
AI_API_KEY=
AI_AUTH_HEADER=
AI_AUTH_PREFIX=
AI_CONTENT_TYPE=application/json
AI_MODEL_NAME=mistral
AI_CONNECT_TIMEOUT=10000
AI_READ_TIMEOUT=60000

# ---------------------------------------------------------------------------
# STREAMLIT FRONTEND CONFIGURATION
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
